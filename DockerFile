FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1


RUN apt-get update && apt-get install -y \
       build-essential \
       git \
       curl \
       && rm -rf /var/lib/apt/lists/*

# FIX: install uv (which provides the `uvx` binary) — your MCP config
# launches the Aviationstack server via `command: "uvx"`, and without this
# that subprocess can never start in the container, which was taking
# hotel/weather results down with it too.
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

COPY requirements.txt .


RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt


COPY . .


EXPOSE 8000

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]